; Sarla introduction
; intro.srl

mdl cslio
mdl strs

[	; [	dat|str
	; 	id|int
	; ] :=: st|struct	; 構造体とかモジュールとか共用体とかenumとかは静的なブロック束縛だと思っているからこの書き方
						; あくまで書き方の例に挙げただけだからコメントアウトしてるけどね

	main()|int public ; 型名後置なのはそうでもしないと曖昧さが残るから。パイプで繋いでるのは丁度いい見た目をしてるから
	[	s|str	; 変数は基本同一スコープ以下でのみ参照可能 (上位スコープにある変数と同じ名前の変数名で変数アクセス先を一時上書き可能)
				; 上位スコープから下位スコープの変数を参照したいならその変数にdomを付ける (Domination) 。s|str domって感じ。
				; dom変数は実質的なグローバル変数として機能する。完全な代替では無い。
				; その為変数名一時上書きが出来無い。
				; 但しモジュールを挟んでってことは無いのでそこは安心 (他のモジュールのdom変数はアクセス出来無い) 。

		to(strs:scmp(s, `cmd_end_`)) ; while。if,for,whileは動的なブロック束縛だから後置にすると不味いのよ
		[	s <- cslio:in() ; 代入演算子って悩みの種だよねぇ ... <-記号はとてつもなく「代入です」の見た目なのだけれど。
							; でも比較演算子+負の数になると状況が悪化すると言う。どうしたものかねぇ。値には常に値であることを表す記号 ...
							; 例えば#で10進数、$で16進数を強制すれば対処できるんだけどねぇ。
							; まぁそれでいっかぁ。
			putchrl(s) ; 同じモジュール内の別の関数なら名前空間指定は要らない
		] cslio:outln(`end of input`)

		ret(#0)
	]

	putchrl(s|str)|bool ; 関数はpublicを付けない限りprivate。
	[	if(!strs:valid(s))
			trp($400)	; 割り込み―。215の奴。
						; Sarlaはインタプリタ実行が出来て、
						; コンパイラを使えば215のアセンブラで215バイナリにアセンブルされて (215もVMを用意するつもりだから此の儘でも実行出来る) 、
						; そこからネイティブにトランスされるからねぇ

		size|int <- strs:slen(s)

		for(i|int <- #0, i < size, i++)
		[	cslio:put(strs:getc(s, i)) ; s_iとしてはいけない、(chr*)sや(chr)s_(#10)とstr型は別物。配列アクセスs_iはエラー。
			cslio:out(`\n`)
		]

		ret(true)
	]
] :=: intro|mdl
